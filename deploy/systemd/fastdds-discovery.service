[Unit]
Description=Fast DDS Discovery Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/voxl-ros2-network
ExecStart=/bin/bash -lc 'for setup in /opt/ros/foxy/setup.bash /opt/ros/humble/setup.bash /opt/ros/iron/setup.bash /opt/ros/jazzy/setup.bash; do if [ -f "$${setup}" ]; then source "$${setup}"; break; fi; done; PATH="$$PATH:/opt/ros/foxy/bin:/opt/ros/humble/bin:/opt/ros/iron/bin:/opt/ros/jazzy/bin"; FASTDDS_BIN_RESOLVED=""; if [ -n "$${FASTDDS_BIN:-}" ] && [ -x "$${FASTDDS_BIN}" ]; then FASTDDS_BIN_RESOLVED="$${FASTDDS_BIN}"; elif command -v fastdds >/dev/null 2>&1; then FASTDDS_BIN_RESOLVED="$$(command -v fastdds)"; elif command -v fast-discovery-server >/dev/null 2>&1; then FASTDDS_BIN_RESOLVED="$$(command -v fast-discovery-server)"; elif [ -x "/opt/ros/foxy/bin/fastdds" ]; then FASTDDS_BIN_RESOLVED="/opt/ros/foxy/bin/fastdds"; elif [ -x "/opt/ros/humble/bin/fastdds" ]; then FASTDDS_BIN_RESOLVED="/opt/ros/humble/bin/fastdds"; elif [ -x "/opt/ros/foxy/bin/fast-discovery-server" ]; then FASTDDS_BIN_RESOLVED="/opt/ros/foxy/bin/fast-discovery-server"; elif [ -x "/opt/ros/humble/bin/fast-discovery-server" ]; then FASTDDS_BIN_RESOLVED="/opt/ros/humble/bin/fast-discovery-server"; fi; if [ -z "$${FASTDDS_BIN_RESOLVED}" ]; then echo "fastdds / fast-discovery-server not found (set FASTDDS_BIN in /etc/default/voxl-ros2-network if needed)" >&2; exit 127; fi; case "$$(basename "$${FASTDDS_BIN_RESOLVED}")" in fastdds) exec "$${FASTDDS_BIN_RESOLVED}" discovery --server-id 0 --ip-address 0.0.0.0 --port 11811 ;; *) exec "$${FASTDDS_BIN_RESOLVED}" -i 0 -l 0.0.0.0 -p 11811 ;; esac'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
